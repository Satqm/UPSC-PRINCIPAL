  {
    "Question_Number": 62,
    "Question_Text": "When variables are measured strictly on a Nominal scale, the only appropriate measure of Central Tendency is the:",
    "Option_A": "Arithmetic Mean",
    "Option_B": "Mode",
    "Option_C": "Median",
    "Option_D": "Harmonic Mean",
    "Correct_Answer": "Option B",
    "Brief_Explanation": "Nominal data represents distinct, unranked categories. Since mean and median require ordering or numerical values, the mode (most frequent category) is the only valid measure."
  },
