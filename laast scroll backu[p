<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover" />
    <title>UPSC Principal Exam - Pro Simulator</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Poppins:wght@500;600;700&display=swap');

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            -webkit-tap-highlight-color: transparent;
        }

        body {
            font-family: 'Inter', sans-serif;
            background: radial-gradient(circle at top center, #0f172a 0%, #020617 100%);
            color: #f8fafc;
            min-height: 100vh;
            min-height: 100dvh;
            background-attachment: fixed;
            overflow-x: hidden;
            padding-bottom: 0; /* removed old padding, handled per view */
            padding-top: 8px;
            overscroll-behavior-y: contain;
            -webkit-overflow-scrolling: touch;
            user-select: none;
            -webkit-user-select: none;
            display: flex;
            flex-direction: column;
        }

        h1, h2, h3, .poppins {
            font-family: 'Poppins', sans-serif;
        }

        .glass-card {
            background: rgba(255, 255, 255, 0.02);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.08);
            box-shadow: 0 4px 30px rgba(0, 0, 0, 0.5);
        }

        /* ── Social Footer (inside views) ── */
        .section-footer {
            display: flex;
            gap: 1.5rem;
            justify-content: center;
            align-items: center;
            padding: 1rem 0;
            margin-top: auto;
        }
        .sf-icon {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background: rgba(255,255,255,0.05);
            border: 1px solid rgba(255,255,255,0.2);
            color: #cbd5e1;
            font-size: 18px;
            transition: all 0.2s;
            text-decoration: none;
        }
        .sf-icon:hover {
            background: rgba(255,255,255,0.15);
            border-color: #60a5fa;
            color: #fff;
            transform: translateY(-2px);
        }
        .sf-icon.ig:hover { background: #d6249f; border-color: #d6249f; }
        .sf-icon.li:hover { background: #0077b5; border-color: #0077b5; }
        .sf-icon.yt:hover { background: #ff0000; border-color: #ff0000; }
        .sf-icon.tg:hover { background: #0088cc; border-color: #0088cc; }

        /* ── Option Buttons ── */
        .option-btn {
            background: linear-gradient(145deg, #1e293b 0%, #0f172a 100%);
            border: 2px solid #334155;
            transition: all 0.15s ease-out;
            cursor: pointer;
            user-select: none;
            -webkit-tap-highlight-color: transparent;
            text-align: left;
            padding: 16px 16px;
            border-radius: 14px;
            font-size: 14px;
            color: #f1f5f9;
            width: 100%;
            display: flex;
            align-items: flex-start;
            gap: 10px;
            min-height: 52px;
            -webkit-touch-callout: none;
            touch-action: manipulation;
        }
        .option-btn:active:not(:disabled) {
            transform: scale(0.97);
            transition: transform 0.08s ease-out;
        }
        .option-btn:hover:not(:disabled) {
            background: linear-gradient(145deg, #2563eb 0%, #1d4ed8 100%);
            border-color: #60a5fa;
            transform: translateY(-1px);
            box-shadow: 0 4px 15px rgba(37, 99, 235, 0.3);
        }
        .option-selected {
            background: linear-gradient(145deg, #d97706 0%, #b45309 100%) !important;
            border-color: #fcd34d !important;
            transform: scale(0.98);
        }
        .option-correct {
            background: linear-gradient(145deg, #047857 0%, #064e3b 100%) !important;
            border-color: #34d399 !important;
            box-shadow: 0 0 15px rgba(52, 211, 153, 0.35);
        }
        .option-wrong {
            background: linear-gradient(145deg, #991b1b 0%, #7f1d1d 100%) !important;
            border-color: #f87171 !important;
            box-shadow: 0 0 15px rgba(248, 113, 113, 0.35);
        }
        .option-revision-correct {
            background: linear-gradient(145deg, #047857 0%, #064e3b 100%) !important;
            border-color: #34d399 !important;
            box-shadow: 0 0 15px rgba(52, 211, 153, 0.3);
            cursor: default !important;
            opacity: 1 !important;
        }
        .option-revision-correct::before {
            content: "✓ ";
            color: #34d399;
            font-weight: 700;
        }
        .option-revision-neutral {
            opacity: 0.45;
            cursor: default !important;
            filter: grayscale(30%);
        }

        .glow-gold {
            text-shadow: 0 0 10px #fbbf24, 0 0 20px #d97706;
        }
        .glow-red {
            text-shadow: 0 0 10px #ef4444, 0 0 20px #b91c1c;
        }

        /* ── Scrollbar ── */
        ::-webkit-scrollbar { width: 4px; height: 4px; }
        ::-webkit-scrollbar-track { background: transparent; }
        ::-webkit-scrollbar-thumb { background: rgba(255, 255, 255, 0.15); border-radius: 10px; }

        .hide-scroll::-webkit-scrollbar { display: none; }
        .hide-scroll { -ms-overflow-style: none; scrollbar-width: none; }

        /* ── Tables ── */
        .data-table th {
            background: rgba(59, 130, 246, 0.15);
            color: #93c5fd;
            border-bottom: 2px solid #3b82f6;
            white-space: nowrap;
            font-size: 13px;
        }
        .data-table td {
            border-bottom: 1px solid rgba(255, 255, 255, 0.05);
            padding: 10px 12px;
            font-size: 13px;
        }
        .data-table tr:hover td { background: rgba(255, 255, 255, 0.03); }

        .pulse-animation { animation: pulse 1.5s infinite alternate; }
        @keyframes pulse {
            0% { transform: scale(1); }
            100% { transform: scale(1.03); }
        }

        /* ── Mobile Footer (quiz only) ── */
        .mobile-sticky-footer {
            position: fixed;
            bottom: 0;
            left: 0;
            right: 0;
            z-index: 40;
            background: rgba(15, 23, 42, 0.94);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border-top: 1px solid rgba(59, 130, 246, 0.3);
            padding-bottom: env(safe-area-inset-bottom, 8px);
        }

        /* ── Set Cards ── */
        .set-card {
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 20px;
            padding: 20px 18px;
            transition: all 0.25s ease;
            position: relative;
            overflow: hidden;
            touch-action: manipulation;
        }
        .set-card:active { transform: scale(0.98); transition: transform 0.1s ease; }
        .set-card:hover {
            background: rgba(255, 255, 255, 0.06);
            border-color: rgba(59, 130, 246, 0.5);
            transform: translateY(-2px);
            box-shadow: 0 12px 40px rgba(0, 0, 0, 0.4);
        }
        .set-card .badge-resume {
            position: absolute; top: 10px; right: 10px;
            background: #d97706; color: #fff; font-size: 10px; font-weight: 700;
            padding: 4px 10px; border-radius: 20px; animation: pulseBadge 2s infinite; z-index: 2;
        }
        .set-card .badge-completed {
            position: absolute; top: 10px; right: 10px;
            background: #047857; color: #fff; font-size: 10px; font-weight: 700;
            padding: 4px 10px; border-radius: 20px; z-index: 2;
        }
        @keyframes pulseBadge { 0%,100% { box-shadow: 0 0 0 0 rgba(217,119,6,0.4); } 50% { box-shadow: 0 0 0 8px rgba(217,119,6,0); } }
        .set-card .set-number { font-size: 28px; font-weight: 700; color: #60a5fa; font-family: 'Poppins', sans-serif; line-height: 1; }
        .set-card .set-meta { font-size: 12px; color: #94a3b8; margin-top: 2px; }
        .set-card .set-progress { margin-top: 10px; height: 5px; background: rgba(255,255,255,0.06); border-radius: 5px; overflow: hidden; }
        .set-card .set-progress .bar { height: 100%; background: linear-gradient(90deg, #3b82f6, #60a5fa); border-radius: 5px; transition: width 0.6s ease; }
        .set-card .set-status { font-size: 12px; color: #94a3b8; margin-top: 8px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 4px; }
        .set-card .set-status .score-badge { background: rgba(59,130,246,0.15); padding: 3px 12px; border-radius: 12px; color: #93c5fd; font-weight: 600; font-size: 11px; }
        .set-card .btn-group-actions { display: flex; gap: 8px; margin-top: 14px; flex-wrap: wrap; }
        .set-card .btn-group-actions button {
            padding: 11px 16px; border-radius: 10px; font-weight: 600; font-size: 13px;
            border: none; cursor: pointer; transition: all 0.2s; flex: 1; min-width: 70px;
            touch-action: manipulation; -webkit-touch-callout: none;
        }
        .set-card .btn-start { background: linear-gradient(145deg, #2563eb, #1d4ed8); color: #fff; box-shadow: 0 4px 20px rgba(37,99,235,0.2); }
        .set-card .btn-start:active { transform: scale(0.95); }
        .set-card .btn-revision { background: linear-gradient(145deg, #7c3aed, #6d28d9); color: #fff; box-shadow: 0 4px 20px rgba(124,58,237,0.2); }
        .set-card .btn-revision:active { transform: scale(0.95); }

        /* ── Scrollable areas (quiz) ── */
        #question-scroll-area,
        #revision-question-scroll {
            max-height: 38vh;
            overflow-y: auto;
            -webkit-overflow-scrolling: touch;
            overscroll-behavior-y: contain;
            padding-right: 6px;
        }
        #question-scroll-area::-webkit-scrollbar,
        #revision-question-scroll::-webkit-scrollbar { width: 3px; }
        #question-scroll-area::-webkit-scrollbar-thumb,
        #revision-question-scroll::-webkit-scrollbar-thumb { background: rgba(59,130,246,0.3); border-radius: 10px; }

        #options-grid,
        #revision-options-grid {
            max-height: 46vh;
            overflow-y: auto;
            -webkit-overflow-scrolling: touch;
            overscroll-behavior-y: contain;
            padding-right: 4px;
        }
        #options-grid::-webkit-scrollbar,
        #revision-options-grid::-webkit-scrollbar { width: 3px; }
        #options-grid::-webkit-scrollbar-thumb,
        #revision-options-grid::-webkit-scrollbar-thumb { background: rgba(59,130,246,0.3); border-radius: 10px; }

        /* ── Palette ── */
        .palette-btn {
            width: 32px; height: 32px; border-radius: 8px; font-size: 11px; font-weight: 600;
            border: 1.5px solid #475569; background: #1e293b; color: #cbd5e1;
            cursor: pointer; transition: all 0.15s; display: flex; align-items: center; justify-content: center;
            touch-action: manipulation; -webkit-touch-callout: none; flex-shrink: 0;
        }
        .palette-btn:active { transform: scale(0.9); }
        .palette-btn.answered { background: #2563eb; border-color: #60a5fa; color: #fff; }
        .palette-btn.marked-review { background: #d97706; border-color: #fcd34d; color: #fff; }
        .palette-btn.current { border-color: #fff !important; box-shadow: 0 0 0 3px rgba(255,255,255,0.25); transform: scale(1.1); }
        .palette-btn.correct-reveal { background: #047857; border-color: #34d399; color: #fff; }
        .palette-btn.wrong-reveal { background: #991b1b; border-color: #f87171; color: #fff; }

        .sound-toggle {
            width: 36px; height: 36px; border-radius: 50%; background: rgba(255,255,255,0.06);
            border: 1px solid rgba(255,255,255,0.15); color: #94a3b8; cursor: pointer;
            font-size: 16px; display: flex; align-items: center; justify-content: center;
            transition: all 0.2s; touch-action: manipulation;
        }
        .sound-toggle:active { transform: scale(0.9); }
        .sound-toggle.muted { color: #ef4444; border-color: rgba(239,68,68,0.4); background: rgba(239,68,68,0.1); }

        .resume-overlay {
            position: fixed; inset: 0; background: rgba(0,0,0,0.85); backdrop-filter: blur(14px);
            -webkit-backdrop-filter: blur(14px); z-index: 100; display: none;
            align-items: center; justify-content: center; padding: 20px;
        }
        .resume-overlay.active { display: flex; }
        .resume-box {
            background: #1e293b; border: 1px solid rgba(59,130,246,0.3); border-radius: 24px;
            padding: 28px 24px; max-width: 400px; width: 100%; text-align: center; animation: fadeIn 0.3s ease;
        }
        .resume-box h2 { font-size: 20px; font-weight: 700; color: #fff; margin-bottom: 6px; }
        .resume-box p { color: #94a3b8; font-size: 13px; margin-bottom: 18px; }
        .resume-box .btn-group { display: flex; gap: 10px; flex-wrap: wrap; justify-content: center; }
        .resume-box .btn-group button {
            padding: 10px 20px; border-radius: 12px; font-weight: 600; font-size: 14px;
            border: none; cursor: pointer; transition: all 0.2s; flex: 1; min-width: 100px;
            touch-action: manipulation;
        }
        .resume-box .btn-resume { background: linear-gradient(145deg, #2563eb, #1d4ed8); color: #fff; box-shadow: 0 4px 20px rgba(37,99,235,0.3); }
        .resume-box .btn-start-fresh { background: #334155; color: #e2e8f0; }

        @keyframes fadeIn { from { opacity:0; transform: scale(0.92) translateY(10px); } to { opacity:1; transform: scale(1) translateY(0); } }

        .score-club-item {
            display: flex; justify-content: space-between; align-items: center;
            padding: 10px 14px; border-bottom: 1px solid rgba(255,255,255,0.04);
        }
        .score-club-item:last-child { border-bottom: none; }
        .score-club-item .rank { font-weight: 700; color: #60a5fa; width: 30px; font-size: 13px; flex-shrink: 0; }
        .score-club-item .name { flex: 1; font-size: 13px; color: #e2e8f0; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; padding: 0 8px; }
        .score-club-item .score { font-weight: 700; color: #fbbf24; font-size: 15px; flex-shrink: 0; }

        .revision-banner {
            background: linear-gradient(90deg, rgba(124,58,237,0.2), rgba(124,58,237,0.05));
            border: 1px solid rgba(124,58,237,0.3); border-radius: 10px;
            padding: 8px 14px; font-size: 12px; color: #c4b5fd;
            display: flex; align-items: center; gap: 8px; flex-wrap: wrap;
        }
        .revision-banner .exit-btn {
            margin-left: auto; background: rgba(255,255,255,0.08); border: none;
            color: #e2e8f0; padding: 5px 14px; border-radius: 8px; font-size: 11px;
            cursor: pointer; transition: background 0.2s; touch-action: manipulation;
        }
        .revision-banner .exit-btn:active { background: rgba(255,255,255,0.2); }

        .tab-btn {
            padding: 8px 14px; border-radius: 10px; font-size: 11px; font-weight: 600;
            transition: all 0.2s; cursor: pointer; border: 1.5px solid transparent;
            color: #94a3b8; background: transparent; white-space: nowrap;
            touch-action: manipulation; -webkit-touch-callout: none;
        }
        .tab-btn:active { transform: scale(0.95); }
        .tab-btn:hover { color: #e2e8f0; background: rgba(255,255,255,0.04); }
        .tab-btn.active { background: #2563eb; color: #fff; border-color: #60a5fa; box-shadow: 0 4px 20px rgba(37,99,235,0.3); }
        .tab-btn i { margin-right: 4px; }

        .toast {
            position: fixed; bottom: 120px; left: 50%; transform: translateX(-50%);
            background: #1e293b; border: 1px solid #3b82f6; color: #e2e8f0;
            padding: 10px 20px; border-radius: 24px; font-size: 12px; font-weight: 600;
            z-index: 200; opacity: 0; pointer-events: none; transition: opacity 0.3s ease, transform 0.3s ease;
            white-space: nowrap;
        }
        .toast.show { opacity: 1; transform: translateX(-50%) translateY(-6px); }

        .timer-urgent { animation: timerFlash 0.6s infinite alternate; }
        @keyframes timerFlash { 0% { opacity: 1; } 100% { opacity: 0.5; } }

        #palette-panel {
            position: fixed; bottom: 100px; left: 0; right: 0;
            background: rgba(15,23,42,0.96); backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border-top: 2px solid rgba(59,130,246,0.4); border-radius: 20px 20px 0 0;
            z-index: 50; padding: 16px 12px 20px; max-height: 55vh;
            overflow-y: auto; display: none; box-shadow: 0 -8px 40px rgba(0,0,0,0.6);
            -webkit-overflow-scrolling: touch;
        }
        #palette-panel.open { display: block; animation: slideUp 0.3s ease; }
        @keyframes slideUp { from { transform: translateY(100%); } to { transform: translateY(0); } }

        @media (max-width: 480px) {
            .set-card { padding: 14px 12px; border-radius: 16px; }
            .set-card .set-number { font-size: 22px; }
            .option-btn { font-size: 13px; padding: 14px 14px; border-radius: 12px; min-height: 48px; }
            #question-scroll-area, #revision-question-scroll { max-height: 32vh; }
            #options-grid, #revision-options-grid { max-height: 40vh; }
            .set-card .btn-group-actions button { font-size: 12px; padding: 10px 12px; min-width: 55px; }
            .resume-box { padding: 22px 16px; }
            .tab-btn { font-size: 10px; padding: 6px 10px; }
            .palette-btn { width: 28px; height: 28px; font-size: 10px; border-radius: 6px; }
            .data-table th, .data-table td { font-size: 11px; padding: 8px 6px; }
        }
        @media (max-width: 380px) {
            .set-card .set-number { font-size: 18px; }
            .set-card .set-meta { font-size: 10px; }
            .option-btn { font-size: 12px; padding: 12px 12px; min-height: 44px; }
            .tab-btn { font-size: 9px; padding: 5px 8px; }
            .tab-btn i { margin-right: 2px; }
        }

        /* ── Quiz container now fills screen, no body scroll ── */
        #quiz-container {
            max-height: calc(100dvh - 180px);
            overflow-y: auto;
            -webkit-overflow-scrolling: touch;
            overscroll-behavior-y: contain;
        }
    </style>
</head>
<body>

    <!-- ===== TOAST ===== -->
    <div id="toast" class="toast">Progress saved</div>

    <!-- ===== RESUME OVERLAY ===== -->
    <div id="resumeOverlay" class="resume-overlay">
        <div class="resume-box">
            <div style="font-size:44px; margin-bottom:6px;">📚</div>
            <h2>Welcome Back!</h2>
            <p id="resume-detail">You have an unfinished test. Continue where you left off?</p>
            <div class="btn-group">
                <button class="btn-resume" onclick="resumeTest()"><i class="fa-solid fa-play"></i> Resume</button>
                <button class="btn-start-fresh" onclick="startFresh()"><i class="fa-solid fa-rotate-right"></i> Fresh Start</button>
            </div>
            <div style="margin-top:12px; font-size:11px; color:#64748b;">
                <span id="resume-progress-text">Set 1 · Question 5 of 100</span>
            </div>
        </div>
    </div>

    <!-- ===== HEADER ===== -->
    <header class="flex flex-wrap justify-between items-center gap-2 glass-card p-2 md:p-3 rounded-xl max-w-6xl mx-auto w-full border-t-2 border-blue-500/50 sticky top-2 z-30 backdrop-blur-sm">
        <div class="flex items-center gap-2 md:gap-3">
            <div class="w-7 h-7 md:w-9 md:h-9 rounded-lg bg-blue-900/40 border border-blue-500 flex items-center justify-center text-blue-400 font-bold poppins shrink-0 text-xs md:text-sm">
                <i class="fa-solid fa-building-columns"></i>
            </div>
            <div>
                <h1 class="text-xs md:text-base font-bold text-blue-400 leading-tight">UPSC PRINCIPAL '26</h1>
                <p class="text-[8px] md:text-[10px] text-gray-400">Pro Simulator</p>
            </div>
        </div>
        <div class="flex items-center gap-1.5 md:gap-3" id="header-controls">
            <button id="soundToggleBtn" class="sound-toggle" onclick="toggleSound()" title="Toggle Sound" aria-label="Toggle sound effects">
                <i class="fa-solid fa-volume-high" id="sound-icon"></i>
            </button>
            <div id="timer-display" class="font-mono text-xs md:text-lg font-bold text-red-400 glow-red px-2 py-1 md:px-3 md:py-1.5 bg-red-950/30 rounded-lg border border-red-500/30 flex items-center gap-1 md:gap-2">
                <i class="fa-regular fa-clock"></i> <span>02:00:00</span>
            </div>
            <button onclick="submitExamEarly()" class="px-2 py-1.5 md:px-3 md:py-2 rounded-lg bg-green-900/40 border border-green-500 text-[10px] md:text-xs font-bold text-green-300 hover:bg-green-600 hover:text-white transition flex items-center gap-1.5 touch-manipulation">
                <i class="fa-solid fa-check-double"></i> <span class="hidden sm:inline">Submit</span>
            </button>
        </div>
    </header>

    <!-- ===== TAB BAR ===== -->
    <div class="flex justify-center mt-2 max-w-6xl mx-auto w-full overflow-x-auto hide-scroll pb-1 px-1">
        <div id="tabs-container" class="glass-card p-1.5 rounded-xl flex gap-1 border border-blue-500/20 bg-black/40 w-max">
            <button class="tab-btn active" data-tab="sets" onclick="showSetSelection()"><i class="fa-solid fa-layer-group"></i> Sets</button>
            <button class="tab-btn" data-tab="analytics" onclick="showAnalytics()"><i class="fa-solid fa-chart-line"></i> Analytics</button>
            <button class="tab-btn" data-tab="club" onclick="showScoreClub()"><i class="fa-solid fa-trophy"></i> Club</button>
            <button class="tab-btn" data-tab="rules" onclick="showRules()"><i class="fa-solid fa-list-check"></i> Rules</button>
        </div>
    </div>

    <!-- ===== VIEW: SET SELECTION ===== -->
    <main id="set-selection-container" class="flex flex-col max-w-6xl mx-auto w-full my-3 px-2">
        <div class="text-center mb-3">
            <h2 class="text-xl md:text-3xl font-bold text-white poppins"><span class="text-blue-400">Select</span> Your Test Set</h2>
            <p class="text-gray-400 text-xs md:text-sm mt-1">Start a new test or revise an attempted set</p>
        </div>
        <div id="set-cards-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3 md:gap-4"></div>
