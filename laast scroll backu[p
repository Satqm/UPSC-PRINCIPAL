    <!-- ===== AUDIO & APP LOGIC (unchanged from your original, only minor adjustments noted) ===== -->
    <script>
        let soundEnabled = true;
        const audioCtx = new (window.AudioContext || window.webkitAudioContext)();

        function playBeep(freq = 440, type = 'sine', duration = 0.15) {
            if (!soundEnabled) return;
            if (audioCtx.state === 'suspended') audioCtx.resume();
            const osc = audioCtx.createOscillator();
            const gain = audioCtx.createGain();
            osc.type = type;
            osc.frequency.value = freq;
            gain.gain.setValueAtTime(0.08, audioCtx.currentTime);
            gain.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + duration);
            osc.connect(gain);
            gain.connect(audioCtx.destination);
            osc.start();
            osc.stop(audioCtx.currentTime + duration);
        }

        function soundCorrect() { playBeep(600, 'triangle', 0.12); setTimeout(() => playBeep(800, 'triangle', 0.18), 80); }
        function soundWrong() { playBeep(250, 'sawtooth', 0.18); setTimeout(() => playBeep(200, 'sawtooth', 0.25), 120); }

        function toggleSound() {
            soundEnabled = !soundEnabled;
            const icon = document.getElementById('sound-icon');
            const btn = document.getElementById('soundToggleBtn');
            if (soundEnabled) {
                icon.className = 'fa-solid fa-volume-high';
                btn.classList.remove('muted');
                showToast('Sound ON');
            } else {
                icon.className = 'fa-solid fa-volume-xmark';
                btn.classList.add('muted');
                showToast('Sound OFF');
            }
        }

        function showToast(msg) {
            const toast = document.getElementById('toast');
            toast.textContent = msg;
            toast.classList.add('show');
            clearTimeout(toast._timeout);
            toast._timeout = setTimeout(() => toast.classList.remove('show'), 1500);
        }

        function dismissModal(event) {
            if (event.target === document.getElementById('explanation-modal')) {
                document.getElementById('explanation-modal').classList.add('hidden');
            }
        }

        // ── DATA & STATE ──
        let allQuestionsPool = [];
        let chunkedSets = [];
        let currentSetIndex = 0;
        let currentQIndex = 0;
        let isAnswered = false;
        let sessionState = [];
        let markedForReview = new Set();
        let stats = { correct: 0, wrong: 0 };
        let timerInterval;
        let timeRemaining = 120 * 60;
        let isTestActive = false;
        let isRevisionMode = false;
        let revisionSetIndex = -1;

        function shuffleArray(array) {
            for (let i = array.length - 1; i > 0; i--) {
                const j = Math.floor(Math.random() * (i + 1));
                [array[i], array[j]] = [array[j], array[i]];
            }
        }

        function normalizeData(rawData) {
            return rawData.map(item => {
                if (item.question && item.options) return item;
                if (item.Question_Text) {
                    let cIndex = 0;
                    const ansStr = String(item.Correct_Answer).toUpperCase();
                    if (ansStr.includes("A")) cIndex = 0;
                    else if (ansStr.includes("B")) cIndex = 1;
                    else if (ansStr.includes("C")) cIndex = 2;
                    else if (ansStr.includes("D")) cIndex = 3;
                    return { question: item.Question_Text, options: [item.Option_A, item.Option_B, item.Option_C, item.Option_D], correctOption: cIndex, explanation: item.Brief_Explanation || "No explanation provided." };
                }
                return item;
            });
        }

        const STORAGE_KEY = 'upscPrincipalProgress';

        function saveProgress() {
            if (!isTestActive || isRevisionMode) return;
            const data = {
                setIndex: currentSetIndex,
                qIndex: currentQIndex,
                sessionState: sessionState.map(s => s ? { selected: s.selected, isCorrect: s.isCorrect } : null),
                markedForReview: Array.from(markedForReview),
                stats: { correct: stats.correct, wrong: stats.wrong },
                timeRemaining: timeRemaining,
                timestamp: Date.now(),
                totalSets: chunkedSets.length,
                setLength: chunkedSets[currentSetIndex] ? chunkedSets[currentSetIndex].length : 0
            };
            try { localStorage.setItem(STORAGE_KEY, JSON.stringify(data)); } catch (e) {}
        }

        function loadProgress() {
            try {
                const raw = localStorage.getItem(STORAGE_KEY);
                if (!raw) return null;
                const data = JSON.parse(raw);
                if (typeof data.setIndex !== 'number' || typeof data.qIndex !== 'number' || !Array.isArray(data.sessionState) || !data.stats) return null;
                return data;
            } catch (e) { return null; }
        }

        function clearProgress() { localStorage.removeItem(STORAGE_KEY); }
        function hasSavedProgress() { return !!loadProgress(); }

        function getHistory() { return JSON.parse(localStorage.getItem('upscPrincipalHistory')) || []; }
        function saveToHistory(finalScore, correct, wrong, setNum) {
            let history = getHistory();
            history.unshift({
                date: new Date().toLocaleString('en-IN', { timeZone: 'Asia/Kolkata', dateStyle: 'short', timeStyle: 'short' }),
                set: setNum + 1,
                score: finalScore,
                correct: correct,
                wrong: wrong,
                attempted: correct + wrong
            });
            localStorage.setItem('upscPrincipalHistory', JSON.stringify(history));
        }

        function clearHistory() {
            if (confirm("Delete all past progress and history?")) {
                localStorage.removeItem('upscPrincipalHistory');
                renderDashboardStats();
                renderSetCards();
                renderScoreClub();
                showToast('History cleared');
            }
        }

        function getAttemptedSets() {
            const history = getHistory();
            const setMap = {};
            history.forEach(h => {
                const key = h.set - 1;
                if (!setMap[key]) setMap[key] = [];
                setMap[key].push(h);
            });
            return setMap;
        }

        function getBestScoreForSet(setIdx) {
            const history = getHistory();
            let best = -1;
            history.forEach(h => { if (h.set - 1 === setIdx && h.score > best) best = h.score; });
            return best;
        }

        function isSetAttempted(setIdx) { return getHistory().some(h => h.set - 1 === setIdx); }

        function showResumeOverlay() {
            const overlay = document.getElementById('resumeOverlay');
            const progress = loadProgress();
            if (!progress) { overlay.classList.remove('active'); return; }
            const setNum = progress.setIndex + 1;
            const total = progress.setLength || 100;
            const qNum = Math.min(progress.qIndex + 1, total);
            document.getElementById('resume-progress-text').textContent = `Set ${setNum} · Question ${qNum} of ${total}`;
            document.getElementById('resume-detail').textContent = `You left off on Set ${setNum} at question ${qNum}. Continue where you left off?`;
            overlay.classList.add('active');
        }

        function resumeTest() {
            document.getElementById('resumeOverlay').classList.remove('active');
            const progress = loadProgress();
            if (!progress) { showSetSelection(); return; }
            currentSetIndex = progress.setIndex;
            currentQIndex = progress.qIndex;
            sessionState = progress.sessionState.map(s => s ? { selected: s.selected, isCorrect: s.isCorrect } : null);
            markedForReview = new Set(progress.markedForReview || []);
            stats = { correct: progress.stats.correct, wrong: progress.stats.wrong };
            timeRemaining = progress.timeRemaining || 120 * 60;
            if (!chunkedSets[currentSetIndex]) { showSetSelection(); return; }
            launchTestFromResume();
        }

        function startFresh() {
            document.getElementById('resumeOverlay').classList.remove('active');
            clearProgress();
            showSetSelection();
        }

        function launchTestFromResume() {
            isRevisionMode = false;
            hideAllViews();
            document.getElementById('quiz-container').classList.remove('hidden');
            document.getElementById('quiz-container').classList.add('flex');
            document.getElementById('quiz-footer').classList.remove('hidden');
            document.getElementById('quiz-footer').classList.add('mobile-sticky-footer');
            document.getElementById('header-controls').classList.remove('hidden');
            document.getElementById('mark-review-label').style.display = 'flex';
            isTestActive = true;
            startTimer();
            renderQuestion();
            updateLiveScore();
            renderPalette();
            saveProgress();
            document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
            document.querySelector('[data-tab="sets"]')?.classList.add('active');
        }

        async function initSystem() {
            const files = ['exam-questions-v1.json', 'exam-questions-v2.json', 'exam-questions-v3.json'];
            for (let file of files) {
                try {
                    const res = await fetch(file);
                    if (res.ok) {
                        const data = await res.json();
                        allQuestionsPool = allQuestionsPool.concat(normalizeData(data));
                    }
                } catch (e) { console.log(`Note: ${file} not found.`); }
            }
            if (allQuestionsPool.length === 0) {
                document.getElementById('question-text').innerText = "⚠️ No question files found. Please upload exam-questions-v1.json (or v2/v3).";
                return;
            }
            shuffleArray(allQuestionsPool);
            chunkedSets = [];
            for (let i = 0; i < allQuestionsPool.length; i += 100) {
                chunkedSets.push(allQuestionsPool.slice(i, i + 100));
            }
            renderSetCards();
            renderDashboardStats();
            renderScoreClub();
            if (hasSavedProgress()) {
                setTimeout(showResumeOverlay, 400);
            } else {
                showSetSelection();
            }
        }

        function renderSetCards() {
            const grid = document.getElementById('set-cards-grid');
            grid.innerHTML = '';
            const attemptedMap = getAttemptedSets();
            let totalQ = 0;
            chunkedSets.forEach((set, idx) => {
                totalQ += set.length;
                const attempted = isSetAttempted(idx);
                const best = getBestScoreForSet(idx);
                const hasProgress = (() => { const p = loadProgress(); return p && p.setIndex === idx; })();

                const card = document.createElement('div');
                card.className = 'set-card';
                let badgeHTML = '';
                if (hasProgress) badgeHTML = '<span class="badge-resume">⏳ Resume</span>';
                else if (attempted) badgeHTML = '<span class="badge-completed">✓ Done</span>';

                card.innerHTML = `
                    ${badgeHTML}
                    <div class="set-number">Set ${idx + 1}</div>
                    <div class="set-meta">${set.length} questions</div>
                    ${attempted ? `<div class="set-status"><span>Best: ${best > -1 ? best : '—'}</span><span class="score-badge">${best > -1 ? best + '/300' : '—'}</span></div>` : '<div class="set-status"><span>&nbsp;</span></div>'}
                    <div class="set-progress"><div class="bar" style="width:${attempted ? 100 : 0}%"></div></div>
                    <div class="btn-group-actions">
                        <button class="btn-start" onclick="startSet(${idx})"><i class="fa-solid fa-play"></i> ${hasProgress ? 'Resume' : 'Start'}</button>
                        ${attempted ? `<button class="btn-revision" onclick="startRevision(${idx})"><i class="fa-solid fa-rotate-right"></i> Revise</button>` : ''}
                    </div>`;
                grid.appendChild(card);
            });
            document.getElementById('total-sets-count').textContent = chunkedSets.length;
            document.getElementById('completed-sets-count').textContent = Object.keys(attemptedMap).length;
            document.getElementById('inprogress-sets-count').textContent = hasSavedProgress() ? 1 : 0;
            document.getElementById('total-questions-count').textContent = totalQ;
        }

        function startSet(idx) {
            const p = loadProgress();
            if (p && p.setIndex === idx) { showResumeOverlay(); return; }
            if (p && p.setIndex !== idx) {
                if (!confirm(`Start Set ${idx + 1}? This will discard your saved progress on Set ${p.setIndex + 1}.`)) return;
                clearProgress();
            }
            if (!p && !confirm(`Start Set ${idx + 1}? The 120-minute timer will begin immediately.`)) return;
            currentSetIndex = idx;
            currentQIndex = 0;
            stats = { correct: 0, wrong: 0 };
            sessionState = new Array(chunkedSets[idx].length).fill(null);
            markedForReview = new Set();
            isTestActive = true;
            isRevisionMode = false;
            timeRemaining = 120 * 60;
            launchTestFromResume();
        }

        function startRevision(idx) {
            if (!isSetAttempted(idx)) { alert("Take the test first before revising."); return; }
            if (isTestActive) {
                if (!confirm("A test is in progress. Exit and start revision?")) return;
                clearProgress();
                isTestActive = false;
                clearInterval(timerInterval);
            }
            revisionSetIndex = idx;
            isRevisionMode = true;
            isTestActive = false;
            clearInterval(timerInterval);
            hideAllViews();
            document.getElementById('revision-container').classList.remove('hidden');
            document.getElementById('revision-container').classList.add('flex');
            document.getElementById('header-controls').classList.add('hidden');
            document.getElementById('palette-panel').classList.remove('open');
            currentQIndex = 0;
            renderRevisionQuestion();
        }

        function exitRevision() {
            isRevisionMode = false;
            revisionSetIndex = -1;
            hideAllViews();
            showSetSelection();
        }

        function renderRevisionQuestion() {
            const set = chunkedSets[revisionSetIndex];
            if (!set || currentQIndex >= set.length) {
                showToast('✅ Revision complete!');
                setTimeout(exitRevision, 600);
                return;
            }
            const q = set[currentQIndex];
            document.getElementById('revision-progress').textContent = `Q: ${currentQIndex + 1}/${set.length}`;
            document.getElementById('revision-question-text').innerHTML = `<span class="text-purple-400 font-bold">Q${currentQIndex + 1}.</span> ${q.question}`;
            const grid = document.getElementById('revision-options-grid');
            grid.innerHTML = '';
            q.options.forEach((opt, idx) => {
                const btn = document.createElement('button');
                const label = String.fromCharCode(65 + idx);
                const isCorrect = (idx === q.correctOption);
                btn.innerHTML = `<span class="text-blue-400 font-bold w-6 text-left shrink-0">${label}.</span> <span>${opt}</span>`;
                btn.className = `option-btn ${isCorrect ? 'option-revision-correct' : 'option-revision-neutral'}`;
                btn.disabled = true;
                btn.style.cursor = 'default';
                grid.appendChild(btn);
            });
        }

        function nextRevisionQuestion() {
            const set = chunkedSets[revisionSetIndex];
            if (!set) { exitRevision(); return; }
            if (currentQIndex < set.length - 1) { currentQIndex++; renderRevisionQuestion(); }
            else { showToast('🎉 End of revision!'); setTimeout(exitRevision, 600); }
        }

        function prevRevisionQuestion() {
            if (currentQIndex > 0) { currentQIndex--; renderRevisionQuestion(); }
        }

        function startTimer() {
            clearInterval(timerInterval);
            updateTimerDisplay();
            timerInterval = setInterval(() => {
                timeRemaining--;
                updateTimerDisplay();
                if (timeRemaining % 15 === 0) saveProgress();
                if (timeRemaining <= 300 && timeRemaining > 0) {
                    document.getElementById('timer-display').classList.add('timer-urgent');
                }
                if (timeRemaining <= 0) {
                    clearInterval(timerInterval);
                    showToast('⏰ Time\'s up! Auto-submitting...');
                    setTimeout(submitExamEarly, 800);
                }
            }, 1000);
        }

        function updateTimerDisplay() {
            const h = Math.floor(timeRemaining / 3600).toString().padStart(2, '0');
            const m = Math.floor((timeRemaining % 3600) / 60).toString().padStart(2, '0');
            const s = (timeRemaining % 60).toString().padStart(2, '0');
            document.getElementById('timer-display').innerHTML = `<i class="fa-regular fa-clock"></i> <span>${h}:${m}:${s}</span>`;
        }

        function renderQuestion() {
            const currentSet = chunkedSets[currentSetIndex];
            if (!currentSet || currentQIndex >= currentSet.length) { submitExamEarly(); return; }
            const q = currentSet[currentQIndex];
            isAnswered = sessionState[currentQIndex] !== null;

            document.getElementById('progress-counter').innerText = `Q: ${currentQIndex + 1}/${currentSet.length}`;
            document.getElementById('question-text').innerHTML = `<span class="text-blue-400 font-bold">Q${currentQIndex + 1}.</span> ${q.question}`;
            document.getElementById('mark-review-checkbox').checked = markedForReview.has(currentQIndex);

            const grid = document.getElementById('options-grid');
            grid.innerHTML = '';
            q.options.forEach((opt, idx) => {
                const btn = document.createElement('button');
                btn.id = `opt-${idx}`;
                const label = String.fromCharCode(65 + idx);
                btn.innerHTML = `<span class="text-blue-400 font-bold w-6 text-left shrink-0">${label}.</span> <span>${opt}</span>`;

                if (!isAnswered) {
                    btn.className = "option-btn";
                    btn.onclick = () => selectOption(idx);
                } else {
                    btn.className = "option-btn opacity-80 cursor-default";
                    btn.onclick = null;
                    if (idx === q.correctOption) btn.classList.add('option-correct', 'opacity-100');
                    else if (idx === sessionState[currentQIndex].selected && !sessionState[currentQIndex].isCorrect) btn.classList.add('option-wrong', 'opacity-100');
                }
                grid.appendChild(btn);
            });
            renderPalette();
            saveProgress();
        }

        function selectOption(idx) {
            if (isAnswered) return;
            playBeep(300, 'sine', 0.08);
            const q = chunkedSets[currentSetIndex][currentQIndex];
            const isCorrect = (idx === q.correctOption);
            isAnswered = true;
            sessionState[currentQIndex] = { selected: idx, isCorrect: isCorrect };
            markedForReview.delete(currentQIndex);
            if (isCorrect) stats.correct++;
            else stats.wrong++;
            updateLiveScore();
            document.getElementById(`opt-${idx}`).classList.add('option-selected');
            setTimeout(() => {
                const selectedBtn = document.getElementById(`opt-${idx}`);
                const correctBtn = document.getElementById(`opt-${q.correctOption}`);
                selectedBtn.classList.remove('option-selected');
                if (isCorrect) {
                    selectedBtn.classList.add('option-correct');
                    soundCorrect();
                    setTimeout(() => showExplanation(true, q, idx), 500);
                } else {
                    selectedBtn.classList.add('option-wrong');
                    if (correctBtn) correctBtn.classList.add('option-correct');
                    soundWrong();
                    setTimeout(() => showExplanation(false, q, idx), 500);
                }
                renderPalette();
                saveProgress();
            }, 350);
        }

        function toggleMarkReview() {
            const checked = document.getElementById('mark-review-checkbox').checked;
            if (checked) markedForReview.add(currentQIndex);
            else markedForReview.delete(currentQIndex);
            renderPalette();
            saveProgress();
        }

        function updateLiveScore() {
            document.getElementById('live-correct').innerText = stats.correct;
            document.getElementById('live-wrong').innerText = stats.wrong;
            document.getElementById('live-score-display').innerText = (stats.correct * 3) - (stats.wrong * 1);
        }

        function showExplanation(isCorrect, q, selectedIdx) {
            const modal = document.getElementById('explanation-modal');
            const title = document.getElementById('modal-title');
            const subtitle = document.getElementById('modal-subtitle');
            if (isCorrect) {
                title.innerHTML = '<i class="fa-solid fa-circle-check text-green-400"></i> <span class="text-green-400">Correct! (+3)</span>';
                subtitle.innerHTML = `<div class="bg-black/50 p-3 rounded-lg border border-green-500/30 text-gray-200 text-xs md:text-sm mt-2"><b>Explanation:</b><br>${q.explanation}</div>`;
            } else {
                title.innerHTML = '<i class="fa-solid fa-circle-xmark text-red-500"></i> <span class="text-red-500">Wrong! (-1)</span>';
                subtitle.innerHTML = `<div class="mb-2 text-xs md:text-sm">Correct: <span class="text-green-400 font-bold">${q.options[q.correctOption]}</span></div><div class="bg-black/50 p-3 rounded-lg border border-red-500/30 text-gray-300 text-xs md:text-sm"><b>Explanation:</b><br>${q.explanation}</div>`;
            }
            modal.classList.remove('hidden');
            saveProgress();
        }

        function nextQuestion() {
            document.getElementById('explanation-modal').classList.add('hidden');
            const currentSet = chunkedSets[currentSetIndex];
            if (currentQIndex < currentSet.length - 1) { currentQIndex++; renderQuestion(); }
            else { submitExamEarly(); }
        }

        function prevQuestion() {
            document.getElementById('explanation-modal').classList.add('hidden');
            if (currentQIndex > 0) { currentQIndex--; renderQuestion(); }
        }

        function jumpToQuestion(qIdx) {
            document.getElementById('explanation-modal').classList.add('hidden');
            if (qIdx >= 0 && qIdx < chunkedSets[currentSetIndex].length) {
                currentQIndex = qIdx;
                renderQuestion();
                togglePalette();
            }
        }

        function togglePalette() {
            const panel = document.getElementById('palette-panel');
            if (panel.classList.contains('open')) { panel.classList.remove('open'); }
            else { renderPalette(); panel.classList.add('open'); }
        }

        function renderPalette() {
            const grid = document.getElementById('palette-grid');
            const set = chunkedSets[currentSetIndex];
            if (!set) { grid.innerHTML = ''; return; }
            grid.innerHTML = '';
            set.forEach((q, idx) => {
                const btn = document.createElement('button');
                btn.textContent = idx + 1;
                btn.className = 'palette-btn';
                if (idx === currentQIndex) btn.classList.add('current');
                if (sessionState[idx] !== null) {
                    btn.classList.add('answered');
                }
                if (markedForReview.has(idx)) btn.classList.add('marked-review');
                btn.onclick = () => jumpToQuestion(idx);
                btn.setAttribute('aria-label', `Question ${idx + 1}`);
                grid.appendChild(btn);
            });
        }

        function submitExamEarly() {
            if (!isTestActive) return;
            const unanswered = sessionState.filter(s => s === null).length;
            const confirmMsg = unanswered > 0 ? `You have ${unanswered} unanswered question(s). Submit anyway?` : 'Submit your test and view results?';
            if (!confirm(confirmMsg)) return;
            isTestActive = false;
            clearInterval(timerInterval);
            clearProgress();
            document.getElementById('palette-panel').classList.remove('open');
            document.getElementById('timer-display').classList.remove('timer-urgent');

            const totalScore = (stats.correct * 3) - (stats.wrong * 1);
            const attempted = stats.correct + stats.wrong;
            document.getElementById('rep-attempted').innerText = attempted;
            document.getElementById('rep-correct').innerText = stats.correct;
            document.getElementById('rep-wrong').innerText = stats.wrong;
            document.getElementById('rep-score').innerText = totalScore;
            saveToHistory(totalScore, stats.correct, stats.wrong, currentSetIndex);
            hideAllViews();
            document.getElementById('end-screen').classList.remove('hidden');
            document.getElementById('end-screen').classList.add('flex');
            document.getElementById('mark-review-label').style.display = 'none';
            renderSetCards();
            renderDashboardStats();
            renderScoreClub();
        }

        function renderDashboardStats() {
            const history = getHistory();
            const tbody = document.getElementById('history-table-body');
            tbody.innerHTML = '';
            if (history.length === 0) {
                document.getElementById('dash-total-tests').innerText = '0';
                document.getElementById('dash-avg-score').innerText = '0';
                document.getElementById('dash-high-score').innerText = '0';
                document.getElementById('dash-accuracy').innerText = '0%';
                tbody.innerHTML = '<tr><td colspan="5" class="p-3 text-center text-gray-500">No attempts yet. Take a test!</td></tr>';
                return;
            }
            let totalScore = 0, highScore = -999, totalCorrect = 0, totalAttempted = 0;
            history.forEach((h, i) => {
                totalScore += h.score;
                if (h.score > highScore) highScore = h.score;
                totalCorrect += h.correct;
                totalAttempted += h.attempted;
                if (i < 10) {
                    tbody.innerHTML += `
                        <tr><td class="p-2 md:p-3">${h.date}</td><td class="p-2 md:p-3 text-center">Set ${h.set}</td>
                        <td class="p-2 md:p-3 text-center text-green-400">${h.correct}</td><td class="p-2 md:p-3 text-center text-red-400">${h.wrong}</td>
                        <td class="p-2 md:p-3 text-center font-bold text-yellow-400">${h.score}</td></tr>`;
                }
            });
            document.getElementById('dash-total-tests').innerText = history.length;
            document.getElementById('dash-avg-score').innerText = Math.round(totalScore / history.length);
            document.getElementById('dash-high-score').innerText = highScore;
            document.getElementById('dash-accuracy').innerText = totalAttempted > 0 ? Math.round((totalCorrect / totalAttempted) * 100) + '%' : '0%';
        }

        function renderScoreClub() {
            const history = getHistory();
            const list = document.getElementById('score-club-list');
            list.innerHTML = '';
            if (history.length === 0) {
                list.innerHTML = '<div class="text-center text-gray-500 p-5">No scores yet. Take a test!</div>';
                return;
            }
            const sorted = [...history].sort((a, b) => b.score - a.score).slice(0, 20);
            sorted.forEach((h, i) => {
                const div = document.createElement('div');
                div.className = 'score-club-item';
                let badge = '';
                if (i === 0) badge = '<span style="background:#fbbf24;color:#0f172a;padding:2px 8px;border-radius:10px;font-size:10px;font-weight:700;">🥇</span>';
                else if (i === 1) badge = '<span style="background:#94a3b8;color:#0f172a;padding:2px 8px;border-radius:10px;font-size:10px;font-weight:700;">🥈</span>';
                else if (i === 2) badge = '<span style="background:#b45309;color:#fff;padding:2px 8px;border-radius:10px;font-size:10px;font-weight:700;">🥉</span>';
                div.innerHTML = `<span class="rank">#${i + 1}</span><span class="name">Set ${h.set} <span class="text-[10px] text-gray-500">${h.date}</span></span><span class="score">${h.score}</span>${badge}`;
                list.appendChild(div);
            });
        }

        function showSetSelection() {
            if (isTestActive) {
                if (!confirm("A test is in progress. Leaving will lose your progress. Continue?")) return;
                clearProgress();
                isTestActive = false;
                clearInterval(timerInterval);
            }
            if (isRevisionMode) exitRevision();
            document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
            document.querySelector('[data-tab="sets"]')?.classList.add('active');
            hideAllViews();
            document.getElementById('set-selection-container').classList.remove('hidden');
            document.getElementById('set-selection-container').classList.add('flex');
            document.getElementById('palette-panel').classList.remove('open');
            document.getElementById('timer-display').classList.remove('timer-urgent');
            renderSetCards();
        }

        function showAnalytics() {
            if (isTestActive) {
                if (!confirm("A test is in progress. Leaving will lose progress. Continue?")) return;
                clearProgress();
                isTestActive = false;
                clearInterval(timerInterval);
            }
            if (isRevisionMode) exitRevision();
            document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
            document.querySelector('[data-tab="analytics"]')?.classList.add('active');
            hideAllViews();
            document.getElementById('analytics-container').classList.remove('hidden');
            document.getElementById('analytics-container').classList.add('flex');
            document.getElementById('palette-panel').classList.remove('open');
            document.getElementById('timer-display').classList.remove('timer-urgent');
            renderDashboardStats();
        }

        function showScoreClub() {
            if (isTestActive) {
                if (!confirm("A test is in progress. Leaving will lose progress. Continue?")) return;
                clearProgress();
                isTestActive = false;
                clearInterval(timerInterval);
            }
            if (isRevisionMode) exitRevision();
            document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
            document.querySelector('[data-tab="club"]')?.classList.add('active');
            hideAllViews();
            document.getElementById('club-container').classList.remove('hidden');
            document.getElementById('club-container').classList.add('flex');
            document.getElementById('palette-panel').classList.remove('open');
            document.getElementById('timer-display').classList.remove('timer-urgent');
            renderScoreClub();
        }

        function showRules() {
            if (isTestActive) {
                if (!confirm("A test is in progress. Leaving will lose progress. Continue?")) return;
                clearProgress();
                isTestActive = false;
                clearInterval(timerInterval);
            }
            if (isRevisionMode) exitRevision();
            document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
            document.querySelector('[data-tab="rules"]')?.classList.add('active');
            hideAllViews();
            document.getElementById('rules-container').classList.remove('hidden');
            document.getElementById('rules-container').classList.add('flex');
            document.getElementById('palette-panel').classList.remove('open');
            document.getElementById('timer-display').classList.remove('timer-urgent');
        }

        function hideAllViews() {
            ['set-selection-container', 'analytics-container', 'club-container', 'rules-container', 'quiz-container', 'revision-container', 'end-screen'].forEach(id => {
                const el = document.getElementById(id);
                el.classList.add('hidden');
                el.classList.remove('flex');
            });
            document.getElementById('quiz-footer').classList.add('hidden');
            document.getElementById('quiz-footer').classList.remove('mobile-sticky-footer');
            document.getElementById('header-controls').classList.remove('hidden');
            document.getElementById('mark-review-label').style.display = 'none';
            document.getElementById('palette-panel').classList.remove('open');
            clearInterval(timerInterval);
        }

        function setupSwipe(elementId, nextFn, prevFn) {
            const el = document.getElementById(elementId);
            if (!el) return;
            let startX = 0, startY = 0, isSwiping = false;
            el.addEventListener('touchstart', function(e) {
                const t = e.touches[0];
                startX = t.clientX;
                startY = t.clientY;
                isSwiping = true;
            }, { passive: true });
            el.addEventListener('touchend', function(e) {
                if (!isSwiping) return;
                isSwiping = false;
                const t = e.changedTouches[0];
                const dx = t.clientX - startX;
                const dy = t.clientY - startY;
                if (Math.abs(dx) > Math.abs(dy) && Math.abs(dx) > 40) {
                    if (dx < 0) nextFn();
                    else prevFn();
                    if (navigator.vibrate) navigator.vibrate(8);
                }
            }, { passive: true });
        }

        document.addEventListener('DOMContentLoaded', function() {
            setupSwipe('question-scroll-area', nextQuestion, prevQuestion);
            setupSwipe('revision-question-scroll', nextRevisionQuestion, prevRevisionQuestion);
            document.addEventListener('keydown', function(e) {
                if (isTestActive && !isRevisionMode) {
                    if (e.key === 'ArrowLeft') { e.preventDefault(); prevQuestion(); }
                    if (e.key === 'ArrowRight') { e.preventDefault(); nextQuestion(); }
                    if (e.key === 'p' || e.key === 'P') { e.preventDefault(); togglePalette(); }
                }
                if (isRevisionMode) {
                    if (e.key === 'ArrowLeft') { e.preventDefault(); prevRevisionQuestion(); }
                    if (e.key === 'ArrowRight') { e.preventDefault(); nextRevisionQuestion(); }
                }
                if (e.key === 'Escape') {
                    document.getElementById('explanation-modal').classList.add('hidden');
                    document.getElementById('palette-panel').classList.remove('open');
                }
            });
            document.addEventListener('click', function(e) {
                const panel = document.getElementById('palette-panel');
                if (panel.classList.contains('open') && !panel.contains(e.target) && !e.target.closest('[onclick="togglePalette()"]')) {
                    panel.classList.remove('open');
                }
            });
        });

        window.onload = initSystem;

        // Global exposures
        window.startSet = startSet;
        window.startRevision = startRevision;
        window.exitRevision = exitRevision;
        window.showSetSelection = showSetSelection;
        window.showAnalytics = showAnalytics;
        window.showScoreClub = showScoreClub;
        window.showRules = showRules;
        window.clearHistory = clearHistory;
        window.resumeTest = resumeTest;
        window.startFresh = startFresh;
        window.submitExamEarly = submitExamEarly;
        window.nextQuestion = nextQuestion;
        window.prevQuestion = prevQuestion;
        window.nextRevisionQuestion = nextRevisionQuestion;
        window.prevRevisionQuestion = prevRevisionQuestion;
        window.togglePalette = togglePalette;
        window.toggleMarkReview = toggleMarkReview;
        window.toggleSound = toggleSound;
        window.jumpToQuestion = jumpToQuestion;
        window.dismissModal = dismissModal;
    </script>
</body>
</html>
