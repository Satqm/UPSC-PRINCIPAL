<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>UPSC Principal Exam - Professional Mock Test</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"/>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Poppins:wght@500;600;700&display=swap');
    
    body {
      font-family: 'Inter', sans-serif;
      background: radial-gradient(circle at top center, #0f172a 0%, #020617 100%);
      color: #f8fafc;
      min-height: 100vh;
      background-attachment: fixed;
    }
    
    h1, h2, h3, .poppins { font-family: 'Poppins', sans-serif; }
    
    .glass-card {
      background: rgba(255, 255, 255, 0.02);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border: 1px solid rgba(255, 255, 255, 0.08);
      box-shadow: 0 4px 30px rgba(0, 0, 0, 0.5);
    }
    
    .option-btn {
      background: linear-gradient(145deg, #1e293b 0%, #0f172a 100%);
      border: 1px solid #334155;
      transition: all 0.2s ease-in-out;
    }
    
    .option-btn:hover:not(:disabled) {
      background: linear-gradient(145deg, #2563eb 0%, #1d4ed8 100%);
      border-color: #60a5fa;
      transform: translateY(-2px);
      box-shadow: 0 4px 15px rgba(37, 99, 235, 0.3);
    }
    
    .option-selected {
      background: linear-gradient(145deg, #d97706 0%, #b45309 100%) !important;
      border-color: #fcd34d !important;
    }
    
    .option-correct {
      background: linear-gradient(145deg, #047857 0%, #064e3b 100%) !important;
      border-color: #34d399 !important;
      box-shadow: 0 0 15px rgba(52, 211, 153, 0.3);
    }
    
    .option-wrong {
      background: linear-gradient(145deg, #991b1b 0%, #7f1d1d 100%) !important;
      border-color: #f87171 !important;
      box-shadow: 0 0 15px rgba(248, 113, 113, 0.3);
    }

    .glow-gold { text-shadow: 0 0 10px #fbbf24, 0 0 20px #d97706; }
    .glow-red { text-shadow: 0 0 10px #ef4444, 0 0 20px #b91c1c; }

    .sf-icon {
      width: 40px; height: 40px;
      border-radius: 50%;
      display: flex; align-items: center; justify-content: center;
      font-size: 1.1rem;
      transition: all 0.3s ease;
      background: rgba(0, 0, 0, 0.4);
    }
    .sf-icon.ig { border: 1px solid #e1306c; color: #e1306c; }
    .sf-icon.ig:hover { background: #e1306c; color: #fff; transform: translateY(-3px); }
    .sf-icon.li { border: 1px solid #0077b5; color: #0077b5; }
    .sf-icon.li:hover { background: #0077b5; color: #fff; transform: translateY(-3px); }
    .sf-icon.yt { border: 1px solid #ff0000; color: #ff0000; }
    .sf-icon.yt:hover { background: #ff0000; color: #fff; transform: translateY(-3px); }
    .sf-icon.tg { border: 1px solid #0088cc; color: #0088cc; }
    .sf-icon.tg:hover { background: #0088cc; color: #fff; transform: translateY(-3px); }

    ::-webkit-scrollbar { width: 6px; height: 6px; }
    ::-webkit-scrollbar-track { background: transparent; }
    ::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.2); border-radius: 10px; }
    ::-webkit-scrollbar-thumb:hover { background: rgba(255,255,255,0.4); }

    .syllabus-table th {
      background: rgba(59, 130, 246, 0.15);
      color: #93c5fd;
      border-bottom: 2px solid #3b82f6;
    }
    .syllabus-table td { border-bottom: 1px solid rgba(255, 255, 255, 0.05); }
    .syllabus-table tr:hover td { background: rgba(255, 255, 255, 0.03); }

    .pulse-animation { animation: pulse 1.5s infinite alternate; }
    @keyframes pulse {
      0% { transform: scale(1); }
      100% { transform: scale(1.05); }
    }
  </style>
</head>
