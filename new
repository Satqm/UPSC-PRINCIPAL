  <!-- Audio System -->
  <script>
    const audioCtx = new (window.AudioContext || window.webkitAudioContext)();
    function playBeep(freq = 440, type = 'sine', duration = 0.15) {
      if (audioCtx.state === 'suspended') audioCtx.resume();
      const osc = audioCtx.createOscillator();
      const gain = audioCtx.createGain();
      osc.type = type; osc.frequency.value = freq;
      gain.gain.setValueAtTime(0.1, audioCtx.currentTime);
      gain.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + duration);
      osc.connect(gain); gain.connect(audioCtx.destination);
      osc.start(); osc.stop(audioCtx.currentTime + duration);
    }
    function soundCorrect() { playBeep(600, 'triangle', 0.15); setTimeout(() => playBeep(800, 'triangle', 0.2), 100); }
    function soundWrong() { playBeep(250, 'sawtooth', 0.2); setTimeout(() => playBeep(200, 'sawtooth', 0.3), 150); }
  </script>

  <!-- Core App Logic -->
  <script>
    // System Architecture
    let allQuestionsPool = [];
    let chunkedSets = [];
    let currentSetIndex = 0;
    let currentQIndex = 0;
    
    // Test Session State
    let isAnswered = false;
    let sessionState = []; // Tracks answered status per question in the active set
    let stats = { correct: 0, wrong: 0 };
    
    // Timer State
    let timerInterval;
    let timeRemaining = 120 * 60; // 120 Minutes

    // 1. Data Normalizer
    function normalizeData(rawData) {
      return rawData.map(item => {
        if(item.question && item.options) return item;
        if(item.Question_Text) {
          let cIndex = 0;
          let ansStr = String(item.Correct_Answer).toUpperCase();
          if (ansStr.includes("A")) cIndex = 0;
          else if (ansStr.includes("B")) cIndex = 1;
          else if (ansStr.includes("C")) cIndex = 2;
          else if (ansStr.includes("D")) cIndex = 3;
          return {
            question: item.Question_Text,
            options: [item.Option_A, item.Option_B, item.Option_C, item.Option_D],
            correctOption: cIndex,
            explanation: item.Brief_Explanation || "No additional explanation provided."
          };
        }
        return item; 
      });
    }

    // 2. Fetch & Consolidate All JSONs
    async function initSystem() {
      const files = ['exam-questions-v1.json', 'exam-questions-v2.json', 'exam-questions-v3.json'];
      
      for(let file of files) {
        try {
          const res = await fetch(file);
          if(res.ok) {
            const data = await res.json();
            allQuestionsPool = allQuestionsPool.concat(normalizeData(data));
          }
        } catch (e) {
          console.log(`Note: ${file} not found or failed to load. Proceeding with available files.`);
        }
      }

      if(allQuestionsPool.length === 0) {
        document.getElementById('question-text').innerText = "Waiting for JSON files to be uploaded. Make sure exam-questions-v1.json is in the directory.";
        return;
      }

      // Chunk into sets of 100
      for(let i = 0; i < allQuestionsPool.length; i += 100) {
        chunkedSets.push(allQuestionsPool.slice(i, i + 100));
      }

      buildTabs();
      loadSet(0); // Load first set by default
    }

    // 3. UI Tab Builder
    function buildTabs() {
      const container = document.getElementById('tabs-container');
      container.innerHTML = '';

      chunkedSets.forEach((set, idx) => {
        const btn = document.createElement('button');
        btn.id = `tab-set-${idx}`;
        const start = (idx * 100) + 1;
        const end = start + set.length - 1;
        btn.innerHTML = `<i class="fa-solid fa-file-lines"></i> Set ${idx + 1} (${start}-${end})`;
        btn.onclick = () => loadSet(idx);
        btn.className = "px-4 py-2 rounded-lg text-xs md:text-sm font-bold transition flex items-center gap-2 text-gray-400 hover:text-white";
        container.appendChild(btn);
      });

      // Add Syllabus Tab
      const sylBtn = document.createElement('button');
      sylBtn.id = 'tab-syllabus';
      sylBtn.innerHTML = `<i class="fa-solid fa-list-check"></i> Rules & Syllabus`;
      sylBtn.onclick = () => showSyllabus();
      sylBtn.className = "px-4 py-2 rounded-lg text-xs md:text-sm font-bold transition flex items-center gap-2 text-gray-400 hover:text-white";
      container.appendChild(sylBtn);
    }

    function updateTabStyles(activeId) {
      const buttons = document.getElementById('tabs-container').children;
      for(let btn of buttons) {
        if(btn.id === activeId) {
          btn.className = "px-4 py-2 rounded-lg text-xs md:text-sm font-bold bg-blue-600 text-white shadow-lg shadow-blue-500/30 flex items-center gap-2";
        } else {
          btn.className = "px-4 py-2 rounded-lg text-xs md:text-sm font-bold text-gray-400 hover:text-white transition flex items-center gap-2";
        }
      }
    }

    // 4. State Management
    function loadSet(setIdx) {
      currentSetIndex = setIdx;
      currentQIndex = 0;
      stats = { correct: 0, wrong: 0 };
      sessionState = new Array(chunkedSets[setIdx].length).fill(null);
      
      updateTabStyles(`tab-set-${setIdx}`);
      
      document.getElementById('syllabus-container').classList.add('hidden');
      document.getElementById('end-screen').classList.add('hidden');
      document.getElementById('quiz-container').classList.remove('hidden');
      document.getElementById('quiz-footer').classList.remove('hidden');
      document.getElementById('header-controls').classList.remove('hidden');
      document.getElementById('quiz-nav-bar').classList.remove('hidden');

      startTimer();
      renderQuestion();
      updateLiveScore();
    }

    function showSyllabus() {
      updateTabStyles('tab-syllabus');
      document.getElementById('quiz-container').classList.add('hidden');
      document.getElementById('quiz-footer').classList.add('hidden');
      document.getElementById('header-controls').classList.add('hidden');
      document.getElementById('end-screen').classList.add('hidden');
      document.getElementById('syllabus-container').classList.remove('hidden');
      clearInterval(timerInterval); // Pause timer when viewing syllabus
    }

    // 5. Timer System
    function startTimer() {
      clearInterval(timerInterval);
      timeRemaining = 120 * 60; 
      updateTimerDisplay();

      timerInterval = setInterval(() => {
        timeRemaining--;
        updateTimerDisplay();
        if(timeRemaining <= 0) {
          clearInterval(timerInterval);
          alert("Time is up! Submitting the test automatically.");
          submitExamEarly();
        }
      }, 1000);
    }

    function updateTimerDisplay() {
      const h = Math.floor(timeRemaining / 3600).toString().padStart(2, '0');
      const m = Math.floor((timeRemaining % 3600) / 60).toString().padStart(2, '0');
      const s = (timeRemaining % 60).toString().padStart(2, '0');
      document.getElementById('timer-display').innerHTML = `<i class="fa-regular fa-clock"></i> <span>${h}:${m}:${s}</span>`;
    }

    // 6. Question Rendering & Logic
    function renderQuestion() {
      const currentSet = chunkedSets[currentSetIndex];
      const q = currentSet[currentQIndex];
      isAnswered = sessionState[currentQIndex] !== null;

      document.getElementById('progress-counter').innerText = `Q: ${currentQIndex + 1} / ${currentSet.length}`;
      document.getElementById('question-text').innerHTML = `<span class="text-blue-400 font-bold">Q${currentQIndex + 1}.</span> ${q.question}`;

      const grid = document.getElementById('options-grid');
      grid.innerHTML = '';

      q.options.forEach((opt, idx) => {
        const btn = document.createElement('button');
        btn.id = `opt-${idx}`;
        const label = String.fromCharCode(65 + idx);
        btn.innerHTML = `<span class="text-blue-400 font-bold w-6 text-left shrink-0">${label}.</span> <span class="text-left">${opt}</span>`;
        
        if(!isAnswered) {
          btn.className = "option-btn p-4 md:p-5 text-[14px] md:text-[15px] font-medium rounded-xl flex items-start gap-2 w-full";
          btn.onclick = () => selectOption(idx);
        } else {
          // Re-render past answered states
          btn.className = "option-btn p-4 md:p-5 text-[14px] md:text-[15px] font-medium rounded-xl flex items-start gap-2 w-full opacity-75 cursor-default";
          if(idx === q.correctOption) {
            btn.classList.add('option-correct', 'opacity-100');
          } else if (idx === sessionState[currentQIndex].selected && !sessionState[currentQIndex].isCorrect) {
            btn.classList.add('option-wrong', 'opacity-100');
          }
        }
        grid.appendChild(btn);
      });
    }

    function selectOption(idx) {
      if (isAnswered) return;
      playBeep(300, 'sine', 0.1);
      
      const q = chunkedSets[currentSetIndex][currentQIndex];
      const isCorrect = (idx === q.correctOption);
      
      // Update State
      isAnswered = true;
      sessionState[currentQIndex] = { selected: idx, isCorrect: isCorrect };
      
      if(isCorrect) stats.correct++;
      else stats.wrong++;
      
      updateLiveScore();

      // UI Update
      document.getElementById(`opt-${idx}`).classList.add('option-selected');
      
      setTimeout(() => {
        const selectedBtn = document.getElementById(`opt-${idx}`);
        const correctBtn = document.getElementById(`opt-${q.correctOption}`);
        
        selectedBtn.classList.remove('option-selected');
        
        if(isCorrect) {
          selectedBtn.classList.add('option-correct');
          soundCorrect();
          setTimeout(() => showExplanation(true, q, idx), 800);
        } else {
          selectedBtn.classList.add('option-wrong');
          if(correctBtn) correctBtn.classList.add('option-correct');
          soundWrong();
          setTimeout(() => showExplanation(false, q, idx), 800);
        }
      }, 500);
    }

    function updateLiveScore() {
      document.getElementById('live-correct').innerText = stats.correct;
      document.getElementById('live-wrong').innerText = stats.wrong;
      
      // Formula: (+3) for correct, (-1) for wrong
      const score = (stats.correct * 3) - (stats.wrong * 1);
      document.getElementById('live-score-display').innerText = Math.max(0, score); // Prevent negative display if preferred, or remove Math.max
    }

    function showExplanation(isCorrect, q, selectedIdx) {
      const modal = document.getElementById('explanation-modal');
      const title = document.getElementById('modal-title');
      const subtitle = document.getElementById('modal-subtitle');

      if (isCorrect) {
        title.innerHTML = `<i class="fa-solid fa-circle-check text-green-400"></i> <span class="text-green-400">Correct! (+3 Marks)</span>`;
        subtitle.innerHTML = `<div class="bg-black/50 p-4 rounded-lg border border-green-500/30 text-gray-200 text-sm mt-2"><b>Explanation:</b><br>${q.explanation}</div>`;
      } else {
        title.innerHTML = `<i class="fa-solid fa-circle-xmark text-red-500"></i> <span class="text-red-500">Incorrect! (-1 Mark)</span>`;
        subtitle.innerHTML = `
          <div class="mb-3">Correct Answer: <span class="text-green-400 font-bold">${q.options[q.correctOption]}</span></div>
          <div class="bg-black/50 p-4 rounded-lg border border-red-500/30 text-gray-300 text-sm"><b>Explanation:</b><br>${q.explanation}</div>`;
      }
      modal.classList.remove('hidden');
    }

    // 7. Navigation
    function nextQuestion() {
      document.getElementById('explanation-modal').classList.add('hidden');
      const currentSet = chunkedSets[currentSetIndex];
      
      if (currentQIndex < currentSet.length - 1) {
        currentQIndex++;
        renderQuestion();
      } else {
        submitExamEarly();
      }
    }

    function prevQuestion() {
      if (currentQIndex > 0) {
        currentQIndex--;
        renderQuestion();
      }
    }

    // 8. End Exam Sequence
    function submitExamEarly() {
      if(!confirm("Are you sure you want to submit the test?")) return;
      
      clearInterval(timerInterval);
      document.getElementById('quiz-container').classList.add('hidden');
      document.getElementById('quiz-footer').classList.add('hidden');
      document.getElementById('header-controls').classList.add('hidden');
      document.getElementById('tabs-container').classList.add('hidden');
      
      const attempted = stats.correct + stats.wrong;
      const totalScore = (stats.correct * 3) - (stats.wrong * 1);
      
      document.getElementById('rep-attempted').innerText = attempted;
      document.getElementById('rep-correct').innerText = stats.correct;
      document.getElementById('rep-wrong').innerText = stats.wrong;
      document.getElementById('rep-score').innerText = totalScore;
      
      document.getElementById('end-screen').classList.remove('hidden');
      document.getElementById('end-screen').classList.add('flex');
    }

    // Initialize Application
    window.onload = initSystem;
  </script>
</body>
</html>
