<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <title>UPSC Principal Exam - Pro Simulator</title>
    <script src="https://cdn.tailwindcss.com">
    </script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Poppins:wght@500;600;700&display=swap');

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'Inter', sans-serif;
            background: radial-gradient(circle at top center, #0f172a 0%, #020617 100%);
            color: #f8fafc;
            min-height: 100vh;
            background-attachment: fixed;
            overflow-x: hidden;
            padding-bottom: 90px;
            padding-top: 10px;
        }

        h1,
        h2,
        h3,
        .poppins {
            font-family: 'Poppins', sans-serif;
        }

        .glass-card {
            background: rgba(255, 255, 255, 0.02);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.08);
            box-shadow: 0 4px 30px rgba(0, 0, 0, 0.5);
        }

        .option-btn {
            background: linear-gradient(145deg, #1e293b 0%, #0f172a 100%);
            border: 1px solid #334155;
            transition: all 0.2s ease-in-out;
            cursor: pointer;
            user-select: none;
            -webkit-tap-highlight-color: transparent;
            text-align: left;
            padding: 14px 18px;
            border-radius: 12px;
            font-size: 14px;
            color: #f1f5f9;
            width: 100%;
            display: flex;
            align-items: flex-start;
            gap: 10px;
        }
        .option-btn:hover:not(:disabled) {
            background: linear-gradient(145deg, #2563eb 0%, #1d4ed8 100%);
            border-color: #60a5fa;
            transform: translateY(-2px);
            box-shadow: 0 4px 15px rgba(37, 99, 235, 0.3);
        }
        .option-selected {
            background: linear-gradient(145deg, #d97706 0%, #b45309 100%) !important;
            border-color: #fcd34d !important;
        }
        .option-correct {
            background: linear-gradient(145deg, #047857 0%, #064e3b 100%) !important;
            border-color: #34d399 !important;
            box-shadow: 0 0 15px rgba(52, 211, 153, 0.3);
        }
        .option-wrong {
            background: linear-gradient(145deg, #991b1b 0%, #7f1d1d 100%) !important;
            border-color: #f87171 !important;
            box-shadow: 0 0 15px rgba(248, 113, 113, 0.3);
        }
        .option-revision-correct {
            background: linear-gradient(145deg, #047857 0%, #064e3b 100%) !important;
            border-color: #34d399 !important;
            box-shadow: 0 0 15px rgba(52, 211, 153, 0.3);
            cursor: default !important;
            opacity: 1 !important;
        }
        .option-revision-correct::before {
            content: "✓ ";
            color: #34d399;
            font-weight: 700;
        }
        .option-revision-neutral {
            opacity: 0.5;
            cursor: default !important;
        }

        .glow-gold {
            text-shadow: 0 0 10px #fbbf24, 0 0 20px #d97706;
        }
        .glow-red {
            text-shadow: 0 0 10px #ef4444, 0 0 20px #b91c1c;
        }

        ::-webkit-scrollbar {
            width: 4px;
            height: 4px;
        }
        ::-webkit-scrollbar-track {
            background: transparent;
        }
        ::-webkit-scrollbar-thumb {
            background: rgba(255, 255, 255, 0.2);
            border-radius: 10px;
        }

        .hide-scroll::-webkit-scrollbar {
            display: none;
        }
        .hide-scroll {
            -ms-overflow-style: none;
            scrollbar-width: none;
        }

        .data-table th {
            background: rgba(59, 130, 246, 0.15);
            color: #93c5fd;
            border-bottom: 2px solid #3b82f6;
            white-space: nowrap;
        }
        .data-table td {
            border-bottom: 1px solid rgba(255, 255, 255, 0.05);
            padding: 10px 12px;
        }
        .data-table tr:hover td {
            background: rgba(255, 255, 255, 0.03);
        }

        .pulse-animation {
            animation: pulse 1.5s infinite alternate;
        }
        @keyframes pulse {
            0% {
                transform: scale(1);
            }
            100% {
                transform: scale(1.03);
            }
        }

        .mobile-sticky-footer {
            position: fixed;
            bottom: 0;
            left: 0;
            right: 0;
            z-index: 40;
            background: rgba(15, 23, 42, 0.92);
            backdrop-filter: blur(12px);
            border-top: 1px solid rgba(59, 130, 246, 0.3);
        }

        /* Set cards */
        .set-card {
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 20px;
            padding: 22px 20px;
            transition: all 0.3s ease;
            position: relative;
            overflow: hidden;
        }
        .set-card:hover {
            background: rgba(255, 255, 255, 0.07);
            border-color: rgba(59, 130, 246, 0.5);
            transform: translateY(-3px);
            box-shadow: 0 12px 40px rgba(0, 0, 0, 0.4);
        }
        .set-card .badge-resume {
            position: absolute;
            top: 12px;
            right: 12px;
            background: #d97706;
            color: #fff;
            font-size: 9px;
            font-weight: 700;
            padding: 3px 10px;
            border-radius: 20px;
            animation: pulseBadge 2s infinite;
        }
        .set-card .badge-completed {
            position: absolute;
            top: 12px;
            right: 12px;
            background: #047857;
            color: #fff;
            font-size: 9px;
            font-weight: 700;
            padding: 3px 10px;
            border-radius: 20px;
        }
        @keyframes pulseBadge {
            0%,
            100% {
                box-shadow: 0 0 0 0 rgba(217, 119, 6, 0.4);
            }
            50% {
                box-shadow: 0 0 0 8px rgba(217, 119, 6, 0);
            }
        }
        .set-card .set-number {
            font-size: 30px;
            font-weight: 700;
            color: #60a5fa;
            font-family: 'Poppins', sans-serif;
            line-height: 1;
        }
        .set-card .set-meta {
            font-size: 13px;
            color: #94a3b8;
            margin-top: 2px;
        }
        .set-card .set-progress {
            margin-top: 12px;
            height: 4px;
            background: rgba(255, 255, 255, 0.06);
            border-radius: 4px;
            overflow: hidden;
        }
        .set-card .set-progress .bar {
            height: 100%;
            background: linear-gradient(90deg, #3b82f6, #60a5fa);
            border-radius: 4px;
            transition: width 0.6s ease;
        }
        .set-card .set-status {
            font-size: 12px;
            color: #94a3b8;
            margin-top: 10px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 4px;
        }
        .set-card .set-status .score-badge {
            background: rgba(59, 130, 246, 0.15);
            padding: 2px 12px;
            border-radius: 12px;
            color: #93c5fd;
            font-weight: 600;
            font-size: 12px;
        }
        .set-card .btn-group-actions {
            display: flex;
            gap: 8px;
            margin-top: 14px;
            flex-wrap: wrap;
        }
        .set-card .btn-group-actions button {
            padding: 10px 18px;
            border-radius: 10px;
            font-weight: 600;
            font-size: 14px;
            border: none;
            cursor: pointer;
            transition: all 0.2s;
            flex: 1;
            min-width: 80px;
        }
        .set-card .btn-start {
            background: linear-gradient(145deg, #2563eb, #1d4ed8);
            color: #fff;
            box-shadow: 0 4px 20px rgba(37, 99, 235, 0.2);
        }
        .set-card .btn-start:hover {
            transform: scale(1.02);
            box-shadow: 0 6px 30px rgba(37, 99, 235, 0.35);
        }
        .set-card .btn-revision {
            background: linear-gradient(145deg, #7c3aed, #6d28d9);
            color: #fff;
            box-shadow: 0 4px 20px rgba(124, 58, 237, 0.2);
        }
        .set-card .btn-revision:hover {
            transform: scale(1.02);
            box-shadow: 0 6px 30px rgba(124, 58, 237, 0.35);
        }
        .set-card .btn-start:disabled,
        .set-card .btn-revision:disabled {
            opacity: 0.4;
            cursor: not-allowed;
            transform: none !important;
        }

        /* Scrollable question area */
        #question-scroll-area,
        #revision-question-scroll {
            max-height: 38vh;
            overflow-y: auto;
            padding-right: 4px;
        }
        #question-scroll-area::-webkit-scrollbar,
        #revision-question-scroll::-webkit-scrollbar {
            width: 3px;
        }
        #question-scroll-area::-webkit-scrollbar-thumb,
        #revision-question-scroll::-webkit-scrollbar-thumb {
            background: rgba(59, 130, 246, 0.3);
            border-radius: 10px;
        }

        #options-grid,
        #revision-options-grid {
            max-height: 42vh;
            overflow-y: auto;
            padding-right: 4px;
        }
        #options-grid::-webkit-scrollbar,
        #revision-options-grid::-webkit-scrollbar {
            width: 3px;
        }
        #options-grid::-webkit-scrollbar-thumb,
        #revision-options-grid::-webkit-scrollbar-thumb {
            background: rgba(59, 130, 246, 0.3);
            border-radius: 10px;
        }

        /* Resume overlay */
        .resume-overlay {
            position: fixed;
            inset: 0;
            background: rgba(0, 0, 0, 0.8);
            backdrop-filter: blur(10px);
            z-index: 100;
            display: none;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }
        .resume-overlay.active {
            display: flex;
        }
        .resume-box {
            background: #1e293b;
            border: 1px solid rgba(59, 130, 246, 0.3);
            border-radius: 24px;
            padding: 32px 28px;
            max-width: 420px;
            width: 100%;
            text-align: center;
            animation: fadeIn 0.3s ease;
        }
        .resume-box h2 {
            font-size: 22px;
            font-weight: 700;
            color: #fff;
            margin-bottom: 6px;
        }
        .resume-box p {
            color: #94a3b8;
            font-size: 14px;
            margin-bottom: 20px;
        }
        .resume-box .btn-group {
            display: flex;
            gap: 12px;
            flex-wrap: wrap;
            justify-content: center;
        }
        .resume-box .btn-group button {
            padding: 10px 24px;
            border-radius: 12px;
            font-weight: 600;
            font-size: 14px;
            border: none;
            cursor: pointer;
            transition: all 0.2s;
            flex: 1;
            min-width: 120px;
        }
        .resume-box .btn-resume {
            background: linear-gradient(145deg, #2563eb, #1d4ed8);
            color: #fff;
            box-shadow: 0 4px 20px rgba(37, 99, 235, 0.3);
        }
        .resume-box .btn-start-fresh {
            background: #334155;
            color: #e2e8f0;
        }
        .resume-box .btn-start-fresh:hover {
            background: #475569;
        }

        @keyframes fadeIn {
            from {
                opacity: 0;
                transform: scale(0.95) translateY(10px);
            }
            to {
                opacity: 1;
                transform: scale(1) translateY(0);
            }
        }

        /* Score club */
        .score-club-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 10px 14px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.04);
        }
        .score-club-item:last-child {
            border-bottom: none;
        }
        .score-club-item .rank {
            font-weight: 700;
            color: #60a5fa;
            width: 30px;
            font-size: 14px;
        }
        .score-club-item .name {
            flex: 1;
            font-size: 14px;
            color: #e2e8f0;
        }
        .score-club-item .score {
            font-weight: 700;
            color: #fbbf24;
            font-size: 16px;
        }
        .score-club-item .badge-gold {
            background: #fbbf24;
            color: #0f172a;
            padding: 2px 10px;
            border-radius: 12px;
            font-size: 10px;
            font-weight: 700;
        }
        .score-club-item .badge-silver {
            background: #94a3b8;
            color: #0f172a;
            padding: 2px 10px;
            border-radius: 12px;
            font-size: 10px;
            font-weight: 700;
        }
        .score-club-item .badge-bronze {
            background: #b45309;
            color: #fff;
            padding: 2px 10px;
            border-radius: 12px;
            font-size: 10px;
            font-weight: 700;
        }

        /* Swipe hint */
        .swipe-hint {
            position: absolute;
            bottom: 10px;
            right: 14px;
            font-size: 11px;
            color: rgba(255, 255, 255, 0.2);
            animation: swipePulse 2.5s infinite;
            pointer-events: none;
            display: flex;
            align-items: center;
            gap: 5px;
        }
        .swipe-hint i {
            font-size: 16px;
        }
        @keyframes swipePulse {
            0%,
            100% {
                opacity: 0.2;
                transform: translateX(0);
            }
            50% {
                opacity: 0.6;
                transform: translateX(6px);
            }
        }

        /* Revision banner */
        .revision-banner {
            background: linear-gradient(90deg, rgba(124, 58, 237, 0.2), rgba(124, 58, 237, 0.05));
            border: 1px solid rgba(124, 58, 237, 0.3);
            border-radius: 10px;
            padding: 8px 16px;
            font-size: 13px;
            color: #c4b5fd;
            display: flex;
            align-items: center;
            gap: 10px;
            flex-wrap: wrap;
        }
        .revision-banner .exit-btn {
            margin-left: auto;
            background: rgba(255, 255, 255, 0.08);
            border: none;
            color: #e2e8f0;
            padding: 4px 14px;
            border-radius: 8px;
            font-size: 12px;
            cursor: pointer;
            transition: background 0.2s;
        }
        .revision-banner .exit-btn:hover {
            background: rgba(255, 255, 255, 0.15);
        }

        /* Tabs */
        .tab-btn {
            padding: 8px 16px;
            border-radius: 10px;
            font-size: 12px;
            font-weight: 600;
            transition: all 0.2s;
            cursor: pointer;
            border: 1px solid transparent;
            color: #94a3b8;
            background: transparent;
            white-space: nowrap;
        }
        .tab-btn:hover {
            color: #e2e8f0;
            background: rgba(255, 255, 255, 0.05);
        }
        .tab-btn.active {
            background: #2563eb;
            color: #fff;
            border-color: #60a5fa;
            box-shadow: 0 4px 20px rgba(37, 99, 235, 0.3);
        }
        .tab-btn i {
            margin-right: 6px;
        }

        /* Responsive */
        @media (max-width: 480px) {
            .set-card {
                padding: 16px 14px;
            }
            .set-card .set-number {
                font-size: 22px;
            }
            .option-btn {
                font-size: 13px;
                padding: 12px 14px;
            }
            #question-scroll-area,
            #revision-question-scroll {
                max-height: 32vh;
            }
            #options-grid,
            #revision-options-grid {
                max-height: 40vh;
            }
            .set-card .btn-group-actions button {
                font-size: 12px;
                padding: 8px 12px;
                min-width: 60px;
            }
            .resume-box {
                padding: 24px 18px;
            }
            .resume-box .btn-group button {
                min-width: 100px;
                padding: 10px 16px;
                font-size: 13px;
            }
        }
        @media (max-width: 380px) {
            .set-card .set-number {
                font-size: 18px;
            }
            .set-card .set-meta {
                font-size: 11px;
            }
            .option-btn {
                font-size: 12px;
                padding: 10px 12px;
            }
        }
    </style>
</head>
<body>

    <!-- ===== RESUME OVERLAY ===== -->
    <div id="resumeOverlay" class="resume-overlay">
        <div class="resume-box">
            <div style="font-size:48px; margin-bottom:8px;">📚</div>
            <h2>Welcome Back!</h2>
            <p id="resume-detail">You have an unfinished test. Would you like to continue where you left off?</p>
            <div class="btn-group">
                <button class="btn-resume" onclick="resumeTest()"><i class="fa-solid fa-play"></i> Resume Test</button>
                <button class="btn-start-fresh" onclick="startFresh()"><i class="fa-solid fa-rotate-right"></i> Start Fresh</button>
            </div>
            <div style="margin-top:14px; font-size:12px; color:#64748b;">
                <span id="resume-progress-text">Set 1 · Question 5 of 100</span>
            </div>
        </div>
    </div>

    <!-- ===== HEADER ===== -->
    <header class="flex flex-wrap justify-between items-center gap-3 glass-card p-3 md:p-4 rounded-xl max-w-6xl mx-auto w-full border-t-2 border-blue-500/50 sticky top-2 z-30 backdrop-blur-sm">
        <div class="flex items-center gap-2 md:gap-3">
            <div class="w-8 h-8 md:w-10 md:h-10 rounded-lg bg-blue-900/40 border border-blue-500 flex items-center justify-center text-blue-400 font-bold poppins shrink-0 text-sm md:text-base">
                <i class="fa-solid fa-building-columns"></i>
            </div>
            <div>
                <h1 class="text-sm md:text-lg font-bold text-blue-400 leading-tight">UPSC PRINCIPAL '26</h1>
                <p class="text-[9px] md:text-xs text-gray-400">Professional Simulator</p>
            </div>
        </div>
        <div class="flex items-center gap-2 md:gap-4" id="header-controls">
            <div id="timer-display" class="font-mono text-sm md:text-xl font-bold text-red-400 glow-red px-2 py-1 md:px-3 md:py-1.5 bg-red-950/30 rounded-lg border border-red-500/30 flex items-center gap-1 md:gap-2">
                <i class="fa-regular fa-clock"></i> <span>02:00:00</span>
            </div>
            <button onclick="submitExamEarly()" class="px-2 py-1.5 md:px-4 md:py-2 rounded-lg bg-green-900/40 border border-green-500 text-[10px] md:text-xs font-bold text-green-300 hover:bg-green-600 hover:text-white transition flex items-center gap-1.5">
                <i class="fa-solid fa-check-double"></i> <span class="hidden sm:inline">Submit</span>
            </button>
        </div>
    </header>

    <!-- ===== TAB BAR ===== -->
    <div class="flex justify-center mt-3 max-w-6xl mx-auto w-full overflow-x-auto hide-scroll pb-1">
        <div id="tabs-container" class="glass-card p-1.5 rounded-xl flex gap-1.5 border border-blue-500/20 bg-black/40 w-max">
            <button class="tab-btn active" data-tab="sets" onclick="showSetSelection()">
                <i class="fa-solid fa-layer-group"></i> Sets
            </button>
            <button class="tab-btn" data-tab="analytics" onclick="showAnalytics()">
                <i class="fa-solid fa-chart-line"></i> Analytics
            </button>
            <button class="tab-btn" data-tab="club" onclick="showScoreClub()">
                <i class="fa-solid fa-trophy"></i> Score Club
            </button>
            <button class="tab-btn" data-tab="rules" onclick="showRules()">
                <i class="fa-solid fa-list-check"></i> Rules
            </button>
        </div>
    </div>

    <!-- ============================================================ -->
    <!-- ===================== VIEW: SET SELECTION ==================== -->
    <!-- ============================================================ -->
    <main id="set-selection-container" class="flex flex-col max-w-6xl mx-auto w-full my-4 px-2">
        <div class="text-center mb-4">
            <h2 class="text-2xl md:text-4xl font-bold text-white poppins">
                <span class="text-blue-400">Select</span> Your Test Set
            </h2>
            <p class="text-gray-400 text-sm mt-1">Choose a set to start practice or revise attempted sets</p>
        </div>

        <div id="set-cards-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
            <!-- Injected by JS -->
        </div>

        <div class="mt-6 grid grid-cols-2 md:grid-cols-4 gap-3 glass-card p-4 rounded-xl border border-blue-500/20">
            <div class="text-center">
                <div class="text-xs text-gray-400">Total Sets</div>
                <div class="text-xl font-bold text-blue-400" id="total-sets-count">0</div>
            </div>
            <div class="text-center">
                <div class="text-xs text-gray-400">Completed</div>
                <div class="text-xl font-bold text-green-400" id="completed-sets-count">0</div>
            </div>
            <div class="text-center">
                <div class="text-xs text-gray-400">In Progress</div>
                <div class="text-xl font-bold text-yellow-400" id="inprogress-sets-count">0</div>
            </div>
            <div class="text-center">
                <div class="text-xs text-gray-400">Total Questions</div>
                <div class="text-xl font-bold text-white" id="total-questions-count">0</div>
            </div>
        </div>
    </main>

    <!-- ============================================================ -->
    <!-- ===================== VIEW: ANALYTICS ======================== -->
    <!-- ============================================================ -->
    <main id="analytics-container" class="hidden flex-col max-w-6xl mx-auto w-full my-4 px-2">
        <div class="glass-card bg-slate-900/80 border-t-4 border-yellow-500 p-4 md:p-6 rounded-xl shadow-2xl">
            <div class="flex justify-between items-center mb-5">
                <h2 class="text-xl md:text-3xl font-bold text-yellow-400 poppins"><i class="fa-solid fa-chart-line"></i> Progress Analytics</h2>
                <button onclick="clearHistory()" class="text-xs text-red-400 hover:text-red-300 border border-red-500/30 px-3 py-1 rounded-md"><i class="fa-solid fa-trash"></i> Clear</button>
            </div>
            <div class="grid grid-cols-2 md:grid-cols-4 gap-3 md:gap-4 mb-6">
                <div class="bg-black/40 p-3 md:p-4 rounded-xl border border-slate-700 text-center">
                    <div class="text-[10px] md:text-xs text-gray-400 uppercase tracking-widest mb-1">Tests Taken</div>
                    <div class="text-xl md:text-3xl font-bold text-white" id="dash-total-tests">0</div>
                </div>
                <div class="bg-black/40 p-3 md:p-4 rounded-xl border border-blue-900/50 text-center">
                    <div class="text-[10px] md:text-xs text-blue-300 uppercase tracking-widest mb-1">Avg Score</div>
                    <div class="text-xl md:text-3xl font-bold text-blue-400" id="dash-avg-score">0</div>
                </div>
                <div class="bg-black/40 p-3 md:p-4 rounded-xl border border-green-900/50 text-center">
                    <div class="text-[10px] md:text-xs text-green-300 uppercase tracking-widest mb-1">Highest Score</div>
                    <div class="text-xl md:text-3xl font-bold text-green-400" id="dash-high-score">0</div>
                </div>
